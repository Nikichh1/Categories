@model IEnumerable<Category>
@{
    ViewData["Title"] = "Категории";
}
<h1>Категории</h1>
<p><a class="button" asp-action="Create">Създай нова</a></p>
<table>
    <thead><tr><th>Име</th><th>Ред на показване</th><th>Действия</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.DisplayOrder</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Редакция</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Детайли</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Изтриване</a>
            </td>
        </tr>
    }
    </tbody>
</table>
