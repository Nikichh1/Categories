@model Category
@{
    ViewData["Title"] = "Детайли";
}
<h1>@Model.Name</h1>
<p>Номер: @Model.Id</p>
<p>Ред на показване: @Model.DisplayOrder</p>
<h2>Продукти</h2>
<ul>
@foreach (var product in Model.Products)
{
    <li><a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">@product.Name</a></li>
}
</ul>
<a asp-action="Edit" asp-route-id="@Model.Id">Редакция</a> |
<a asp-action="Index">Назад</a>
