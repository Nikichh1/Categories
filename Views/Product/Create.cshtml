@model Product
@{
    ViewData["Title"] = "Добавяне на продукт";
}
<h1>Добавяне на продукт</h1>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <label asp-for="Name">Име</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name" class="text-danger"></span>
    <label asp-for="IdCategory">Категория</label>
    <select asp-for="IdCategory" asp-items="ViewBag.Categories">
        <option value="0">Изберете категория</option>
    </select>
    <span asp-validation-for="IdCategory" class="text-danger"></span>
    <div><button type="submit">Добави</button></div>
</form>
<a asp-action="Index">Назад</a>
