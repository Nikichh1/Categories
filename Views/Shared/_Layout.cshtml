@inject Categories.Data.ApplicationDbContext Db
@using Microsoft.EntityFrameworkCore
@{
    var categories = await Db.Categories.OrderBy(c => c.DisplayOrder).ToListAsync();
}
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Categories</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="container navigation">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.svg" alt="Начало" width="35" height="35" />
                <span>Categories</span>
            </a>
            <a asp-controller="Home" asp-action="Index">Начало</a>
            <details class="dropdown">
                <summary>Категории</summary>
                <div class="dropdown-items">
                    <a asp-controller="Categories" asp-action="Index">Всички категории</a>
                    @foreach (var category in categories)
                    {
                        <a asp-controller="Categories" asp-action="Details" asp-route-id="@category.Id">@category.Name</a>
                    }
                </div>
            </details>
            <a asp-controller="Product" asp-action="Index">Продукти</a>
            <a class="login-button" asp-controller="Account" asp-action="Login">Вход</a>
        </nav>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <footer class="container">
        <p>Categories - ASP.NET Core MVC</p>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
