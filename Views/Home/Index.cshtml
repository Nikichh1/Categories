@model IEnumerable<Category>
@{
    ViewData["Title"] = "Начало";
}
<h1>Категории</h1>
<p>Приложение за управление на категории и продукти.</p>
<a class="button" asp-controller="Categories" asp-action="Create">Добави категория</a>
<table>
    <thead><tr><th>Име</th><th>Ред</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.DisplayOrder</td>
            <td>
                <a asp-controller="Categories" asp-action="Details" asp-route-id="@item.Id">Детайли</a> |
                <a asp-controller="Categories" asp-action="Edit" asp-route-id="@item.Id">Редакция</a> |
                <a asp-controller="Categories" asp-action="Delete" asp-route-id="@item.Id">Изтриване</a>
            </td>
        </tr>
    }
    </tbody>
</table>
